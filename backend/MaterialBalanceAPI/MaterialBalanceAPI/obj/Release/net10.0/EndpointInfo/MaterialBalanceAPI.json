      "get": {
        "tags": [
          "Periods"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/PlantOperations/Model": {
      "get": {
        "tags": [
          "PlantOperations"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
